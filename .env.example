# Copy to .env.local and adjust.

# Backend (vision service). Local dev:
VITE_API_BASE=http://localhost:8000
VITE_WS_BASE=ws://localhost:8000

# When exposing the backend through ngrok, use the https/wss URL instead:
# VITE_API_BASE=https://xxxxxxxx.ngrok-free.app
# VITE_WS_BASE=wss://xxxxxxxx.ngrok-free.app

# Optional: frame stride for the inference socket. 1 = every frame (best
# tracking / incident detection). Raise only if the machine can't keep up.
VITE_STRIDE=1

# Optional: camera marker position for the map panel.
VITE_CAMERA_LAT=4.60971
VITE_CAMERA_LNG=-74.08175
VITE_CAMERA_NAME=Cámara 1
